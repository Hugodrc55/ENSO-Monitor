root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Windows PowerShell 5.1 lit un script sans BOM dans le codage local : les
# accents seraient mal affichés.
[*.ps1]
charset = utf-8-bom
indent_size = 4
