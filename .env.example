# Modèle de configuration locale. Copier ce fichier en .env (exclu de Git),
# puis remplacer le mot de passe. Aucune valeur de ce fichier n'est un vrai secret.

# Lues par Docker Compose pour créer le service PostgreSQL (compose.yaml).
POSTGRES_USER=enso
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-local
POSTGRES_DB=enso_monitor
POSTGRES_PORT=5432

# Lue par SQLAlchemy et Alembic (pilote psycopg 3). Les ${...} reprennent les
# valeurs ci-dessus ; un mot de passe contenant @ : / ou % doit être encodé pour une URL.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}

# Base jetable utilisée par les tests du schéma : ils la vident à chaque exécution.
# Son nom doit se terminer par _test.
TEST_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_PORT}/${POSTGRES_DB}_test
